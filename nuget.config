<?xml version="1.0" encoding="utf-8"?>

<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- The original private feed (git.ryujinx.app, host of Ryujinx.LibHac
             0.21.0-alpha.129 and MoltenVK 1.2.0) is offline since the Ryujinx
             infra shutdown, so those two packages are vendored locally in
             packages/ (drop the .nupkg files there). -->
        <add key="vendored" value="packages" />
    </packageSources>
    <packageSourceMapping>
        <!-- key value for <packageSource> should match key values from <packageSources> element -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="vendored">
            <package pattern="Ryujinx.LibHac" />
            <package pattern="Ryujinx.Graphics.Vulkan.Dependencies.MoltenVK" />
        </packageSource>
    </packageSourceMapping>
</configuration>
